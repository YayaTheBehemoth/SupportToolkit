@* One Acronis figure in GB as the portal shows it (the compared unit),
   plus decimal GB and the bytes in the detailed view, or why it is
   unknown. *@

<tr class="@(Compared ? "cmp" : "")">
    <td>@Label</td>
    @if (Value.IsKnown)
    {
        <td class="num">@Value.Gb!.Value.ToString("#,##0.00", Invariant)</td>
        @if (Detailed)
        {
            <td class="num">@Value.DecimalGb!.Value.ToString("#,##0.00", Invariant)</td>
        }
        @if (Detailed)
        {
            <td class="num">@Value.Bytes!.Value.ToString("#,##0", Invariant)</td>
        }
    }
    else
    {
        <td colspan="@(Detailed ? 3 : 1)" class="problem">unknown: @Value.Problem</td>
    }
</tr>

@code {
    private static readonly System.Globalization.CultureInfo Invariant =
        System.Globalization.CultureInfo.InvariantCulture;

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public UsageMeasurement Value { get; set; } = default!;
    [Parameter] public bool Detailed { get; set; }

    /// <summary>The figure the report compares, highlighted.</summary>
    [Parameter] public bool Compared { get; set; }
}
